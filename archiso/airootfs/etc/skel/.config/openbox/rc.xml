<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <!--
    VS Code OS window manager policy.

    Openbox is used purely as a kiosk frame for VS Code: it gives Electron a
    real window manager (so menus, dialogs and file pickers behave) while
    removing every affordance that could close, minimise, resize or hide the
    editor. There are deliberately no <keyboard> bindings at all, so Alt+F4,
    Alt+Space, Alt+Tab and the workspace shortcuts do nothing.
  -->

  <resistance>
    <strength>0</strength>
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout></titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>Cantarell</name>
      <size>10</size>
    </font>
    <font place="InactiveWindow">
      <name>Cantarell</name>
      <size>10</size>
    </font>
  </theme>

  <desktops>
    <!-- A single desktop: nothing to switch to, nothing to hide behind. -->
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>VS Code</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <applications>
    <!-- The editor itself: always fullscreen, undecorated, unmovable. -->
    <application class="Code" name="code">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>true</maximized>
      <iconic>no</iconic>
      <layer>normal</layer>
      <desktop>1</desktop>
      <focus>yes</focus>
      <skip_pager>yes</skip_pager>
      <skip_taskbar>yes</skip_taskbar>
    </application>
    <application class="Code">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>true</maximized>
      <iconic>no</iconic>
      <focus>yes</focus>
    </application>
    <!-- VS Code's own dialogs (file picker, message boxes): centred, on top,
         decorated enough to be dragged but never minimised away. -->
    <application class="Code" type="dialog">
      <decor>yes</decor>
      <fullscreen>no</fullscreen>
      <maximized>no</maximized>
      <position force="yes">
        <x>center</x>
        <y>center</y>
      </position>
      <layer>above</layer>
    </application>
  </applications>

  <!-- No <keyboard> section: every window-management shortcut is disabled. -->
  <keyboard>
    <chainQuitKey></chainQuitKey>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <context name="Frame">
      <!-- Focus on click, and nothing else. No move, no resize, no menus. -->
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
    <context name="Desktop">
      <!-- Right/middle click on the root window opens nothing. -->
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
      </mousebind>
    </context>
  </mouse>

  <menu>
    <file>menu.xml</file>
    <hideDelay>0</hideDelay>
    <showIcons>no</showIcons>
  </menu>
</openbox_config>
