expat
systemd-libs

# Developer tooling that ships with the OS
#
# Go, Rust and the JDK are deliberately absent. They are the three heaviest
# toolchains Arch offers - well over a gigabyte of installed files between them,
# and machine code, which squashfs only compresses so far - and they were what
# kept the ISO over GitHub's 2 GiB release-asset limit. Anyone who wants them is
# one command away in the editor's terminal:
#
#     sudo pacman -S go rust jdk-openjdk
git
git-lfs
base-devel
nodejs
npm
python
python-pip
docker
docker-compose
man-db
man-pages
less
nano
vim
zip
unzip
# 7zip replaced p7zip in the repositories; the old name only lives on as a
# 'provides', which pacman resolves but the Pi image's package check rejects.
7zip
tree
htop
fastfetch
ripgrep
fd
bash-completion
openssl
gnupg
