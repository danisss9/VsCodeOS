gtk3
nss
nspr
alsa-lib
libxss
libxtst
libxkbcommon
libxkbcommon-x11
libdrm
libcups
at-spi2-core
libnotify
cairo
pango
libx11
libxcomposite
libxdamage
libxext
libxfixes
libxrandr
