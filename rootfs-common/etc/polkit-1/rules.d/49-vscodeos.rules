/* VS Code OS: let the kiosk session act on the machine without a password prompt.
 *
 * There is no polkit authentication agent in this session - the whole desktop is
 * VS Code, and there is nowhere for an agent to draw a dialog. Any action that
 * resolves to auth_admin therefore does not prompt, it simply fails, silently,
 * from the user's point of view. These grants cover exactly the actions the
 * desktop shell (VsCodeOsCore) needs and nothing more.
 *
 * systemd's own policy already answers `yes` to power-off/reboot/suspend for an
 * active seat session, but only while no *other* session is logged in;
 * logind.conf.d/vscodeos.conf keeps six gettys around, and a login on one of
 * them would otherwise turn the shutdown button into a silent no-op.
 *
 * NetworkManager is the more important half: upstream ships
 * settings.modify.system as auth_admin_keep, so without this the Wi-Fi list in
 * the tray would show networks it could never join.
 */

polkit.addRule(function (action, subject) {
    if (!subject.isInGroup("wheel") || !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id.indexOf("org.freedesktop.login1.power-off") === 0
        || action.id.indexOf("org.freedesktop.login1.reboot") === 0
        || action.id.indexOf("org.freedesktop.login1.suspend") === 0
        || action.id.indexOf("org.freedesktop.login1.hibernate") === 0) {
        /* Deliberately not the *-ignore-inhibit variants: if something has taken
           an inhibitor lock, the user should be told, not overridden. */
        if (action.id.indexOf("ignore-inhibit") !== -1) {
            return polkit.Result.NOT_HANDLED;
        }
        return polkit.Result.YES;
    }

    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
        return polkit.Result.YES;
    }

    /* Mounting a USB stick from the file explorer. */
    if (action.id.indexOf("org.freedesktop.udisks2.filesystem-mount") === 0
        || action.id === "org.freedesktop.udisks2.eject-media") {
        return polkit.Result.YES;
    }

    /* The Updater app, which runs `pkexec /usr/local/bin/vscodeos-update`.
       Deliberately one exact program and not a directory or a prefix: this is a
       password-free path to root, and it should reach exactly the one script
       that is meant to be reachable. That script takes a fixed set of words as
       its only argument and runs no user-supplied command line.

       sudo cannot do this job. vscodeos-install rewrites sudoers so wheel
       members authenticate with their own password, and there is no polkit
       agent in this session to draw a prompt with - so an auth_admin answer
       here would not ask, it would silently fail. */
    if (action.id === "org.freedesktop.policykit.exec"
        && action.lookup("program") === "/usr/local/bin/vscodeos-update") {
        return polkit.Result.YES;
    }

    /* Storage Sense, which runs `pkexec /usr/local/bin/vscodeos-clean` to trim
       the package cache and the journal and to remove orphaned packages. Same
       terms as vscodeos-update: one exact program, a fixed vocabulary of words
       as its only arguments, no user-supplied command line and no paths. */
    if (action.id === "org.freedesktop.policykit.exec"
        && action.lookup("program") === "/usr/local/bin/vscodeos-clean") {
        return polkit.Result.YES;
    }

    /* The Firewall app, which runs `pkexec /usr/local/bin/vscodeos-firewall`.
       ufw needs root even to read its status, so this is on the read path too
       and not only on writes. That script takes a fixed vocabulary and one
       argument it checks against a pattern - and, for application profiles,
       against `ufw app list` - before ufw ever sees it. */
    if (action.id === "org.freedesktop.policykit.exec"
        && action.lookup("program") === "/usr/local/bin/vscodeos-firewall") {
        return polkit.Result.YES;
    }

    /* The keyboard pane of System Settings, which persists a layout with
       `localectl set-x11-keymap`. A named systemd action rather than a program
       of ours: localed validates the keymap itself, and the alternative would
       have been a third script writing to /etc/X11. */
    if (action.id === "org.freedesktop.locale1.set-keyboard") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
