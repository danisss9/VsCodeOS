{
  "// VS Code OS": "System defaults. Anything you change here is yours to keep.",

  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "readme",
  "workbench.tips.enabled": false,

  // The notifications bell registers itself at the far right of the status bar
  // at a priority no extension can outrank, so moving notifications to the top
  // right is what frees the bottom-right corner for the shell's power button.
  "workbench.notifications.position": "top-right",

  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "hidden",
  "window.restoreWindows": "all",
  "window.newWindowDimensions": "maximized",
  "window.closeWhenEmpty": false,
  "window.confirmSaveUntitledWorkspace": false,

  "update.mode": "none",
  "update.showReleaseNotes": false,
  "extensions.autoCheckUpdates": true,

  "security.workspace.trust.enabled": false,

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Fira Code', 'Liberation Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,

  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",

  "git.autofetch": true,
  "git.confirmSync": false,
  "telemetry.feedback.enabled": false,

  // The desktop shell. Every feature can be turned off individually; the
  // extension itself is built in and cannot be uninstalled.
  "vscodeos.statusBar.enabled": true,
  "vscodeos.clock.timeFormat": "HH:mm",
  "vscodeos.clock.dateFormat": "dd/MM/yyyy",
  "vscodeos.taskManager.enabled": true,
  "vscodeos.files.enabled": true,
  "vscodeos.music.enabled": true,
  "vscodeos.music.directory": "~/Music",
  "vscodeos.apps.enabled": true,
  "vscodeos.firewall.enabled": true,
  "vscodeos.power.confirm": true,

  // All Apps lists the shell's own apps, the web apps installed from the
  // Marketplace, and everything else on the machine that ships a .desktop file.
  "vscodeos.allApps.systemApps": true,
  "vscodeos.webApps.enabled": true,

  // The tray menus open as popups over the editor. "sidebar" and "panel" swap
  // them for the richer webview cards, at the cost of a container.
  "vscodeos.flyout.location": "popup",

  // The shell serves org.freedesktop.Notifications, so notify-send and any
  // application's notifications become editor notifications. Nothing else on
  // either image claims that bus name; turn this off to leave it to a daemon
  // you install yourself.
  "vscodeos.notifications.enabled": true,
  "vscodeos.notifications.historyLimit": 50,

  // X forgets the key repeat rate with the session, so the shell reapplies
  // these at every login.
  "vscodeos.keyboard.repeatDelay": 500,
  "vscodeos.keyboard.repeatRate": 25
}
