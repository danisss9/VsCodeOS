{
  "name": "vscodeos-core",
  "displayName": "VS Code OS Core",
  "description": "The VS Code OS desktop shell: tray, power menu, clock, task manager, file explorer and mini-apps.",
  "version": "1.0.0",
  "publisher": "vscodeos",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/danisss9/VsCodeOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/danisss9/VsCodeOS.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "icons": {
      "vscodeos-power": {
        "description": "Power (IEC 5009)",
        "default": {
          "fontPath": "./media/icons/vscodeos-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodeos-system",
          "title": "System",
          "icon": "media/icons/system.svg"
        }
      ],
      "panel": [
        {
          "id": "vscodeos-flyout",
          "title": "VS Code OS",
          "icon": "media/icons/system.svg"
        }
      ]
    },
    "views": {
      "vscodeos-system": [
        {
          "type": "webview",
          "id": "vscodeos.flyout",
          "name": "System",
          "when": "config.vscodeos.flyout.location == 'sidebar'"
        },
        {
          "type": "webview",
          "id": "vscodeos.taskManager",
          "name": "Task Manager",
          "icon": "media/icons/system.svg",
          "when": "config.vscodeos.taskManager.enabled"
        }
      ],
      "vscodeos-flyout": [
        {
          "type": "webview",
          "id": "vscodeos.flyout.panel",
          "name": "System",
          "when": "config.vscodeos.flyout.location == 'panel'"
        }
      ]
    },
    "commands": [
      {
        "command": "vscodeos.power.menu",
        "title": "Power\u2026",
        "category": "VS Code OS",
        "icon": "$(vscodeos-power)"
      },
      {
        "command": "vscodeos.power.shutdown",
        "title": "Shut Down",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.power.restart",
        "title": "Restart",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.power.sleep",
        "title": "Sleep",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.power.logout",
        "title": "Log Out",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.calendar.show",
        "title": "Show Calendar",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.power.settings",
        "title": "Show Power Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.volume.show",
        "title": "Show Volume Mixer",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.volume.up",
        "title": "Volume Up",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.volume.down",
        "title": "Volume Down",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.volume.toggleMute",
        "title": "Toggle Mute",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.network.show",
        "title": "Show Networks",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.bluetooth.show",
        "title": "Show Bluetooth",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.music.show",
        "title": "Show Music Player",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.music.playPause",
        "title": "Play / Pause",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.music.next",
        "title": "Next Track",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.music.previous",
        "title": "Previous Track",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.files.open",
        "title": "File Explorer",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.browser.open",
        "title": "Web Browser",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.calculator",
        "title": "Calculator",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.paint",
        "title": "Paint",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.screenshot",
        "title": "Screenshot",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.screenshotRegion",
        "title": "Capture a Region",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.recorder",
        "title": "Voice Recorder",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.player",
        "title": "Media Player",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.updater",
        "title": "Updates",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.open",
        "title": "System Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.display",
        "title": "Display Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.keyboard",
        "title": "Keyboard Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.sound",
        "title": "Sound Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.storage",
        "title": "Storage Sense",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.firewall.open",
        "title": "Firewall",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.settings.accessibility",
        "title": "Accessibility Settings",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.notifications.show",
        "title": "Show Notifications",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.notifications.clear",
        "title": "Clear Notifications",
        "category": "VS Code OS"
      },
      {
        "command": "vscodeos.apps.menu",
        "title": "All Apps\u2026",
        "category": "VS Code OS"
      }
    ],
    "configuration": {
      "title": "VS Code OS",
      "properties": {
        "vscodeos.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the VS Code OS tray block (power, clock, battery, volume, network) in the status bar."
        },
        "vscodeos.clock.timeFormat": {
          "type": "string",
          "default": "HH:mm",
          "description": "Clock format. Tokens: HH, H, hh, h, mm, ss, A, a."
        },
        "vscodeos.clock.dateFormat": {
          "type": "string",
          "default": "dd/MM/yyyy",
          "description": "Date shown next to the clock. Tokens: dd, d, MM, M, MMM, yyyy, yy. Leave empty to hide the date."
        },
        "vscodeos.flyout.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "panel"
          ],
          "enumDescriptions": [
            "In the side bar, next to the Task Manager. Leaves the bottom panel to the terminal.",
            "In the bottom panel, directly above the status bar."
          ],
          "default": "sidebar",
          "description": "Where the tray menus (power, clock, network, Bluetooth, volume, music) open."
        },
        "vscodeos.taskManager.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Task Manager view in the activity bar."
        },
        "vscodeos.taskManager.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Milliseconds between Task Manager samples."
        },
        "vscodeos.files.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the graphical file explorer."
        },
        "vscodeos.music.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the music player and its status bar transport."
        },
        "vscodeos.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Serve org.freedesktop.Notifications, so notify-send and other desktop notifications appear as editor notifications. Turn off to leave the bus name to another daemon."
        },
        "vscodeos.notifications.historyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "description": "How many notifications the notification centre keeps."
        },
        "vscodeos.keyboard.repeatDelay": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 2000,
          "description": "Milliseconds a key is held before it starts repeating. Reapplied at every login, because X forgets it with the session."
        },
        "vscodeos.keyboard.repeatRate": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 110,
          "description": "Key repeats per second once a key has started repeating."
        },
        "vscodeos.firewall.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Firewall app, which drives ufw through a privileged helper."
        },
        "vscodeos.browser.command": {
          "type": "string",
          "default": "",
          "description": "Browser binary to render pages with, and to hand pages to when you choose \"Open in browser\". Empty means: prefer microsoft-edge-stable, then chromium, then firefox."
        },
        "vscodeos.browser.homepage": {
          "type": "string",
          "default": "https://duckduckgo.com",
          "description": "Page the browser opens when no URL is given."
        },
        "vscodeos.browser.frameRate": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 60,
          "description": "Frames per second the in-editor browser streams. Lower it on a Raspberry Pi."
        },
        "vscodeos.browser.quality": {
          "type": "number",
          "default": 65,
          "minimum": 20,
          "maximum": 100,
          "description": "JPEG quality of the in-editor browser's frames. Lower is faster and blurrier."
        },
        "vscodeos.apps.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the built-in mini-apps (calculator, paint, screenshot, recorder, media player)."
        },
        "vscodeos.power.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before shutting down or restarting."
        },
        "vscodeos.screenshot.directory": {
          "type": "string",
          "default": "~/Pictures/Screenshots",
          "description": "Where the screenshot tool saves images."
        },
        "vscodeos.recorder.directory": {
          "type": "string",
          "default": "~/Music/Recordings",
          "description": "Where the voice recorder saves audio."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vscodeos.calendar.show",
          "when": "config.vscodeos.statusBar.enabled"
        },
        {
          "command": "vscodeos.power.settings",
          "when": "config.vscodeos.statusBar.enabled"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "esbuild test/index.test.ts --bundle --platform=node --format=cjs --outfile=out/test.cjs --log-level=error && node --test out/test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "puppeteer-core": "^25.5.0"
  }
}
