# Packages installed on top of the Arch Linux ARM base for Raspberry Pi.
#
# Deliberately leaner than the x86 image: an SD card is small, a Pi has little
# RAM, and the release artifact has to stay under GitHub's 2 GiB asset limit.
# Docker is left out here (the x86 image does ship it), and the heavy toolchains
# - Go, Rust and the JDK - ship on neither image; `sudo pacman -S go rust
# jdk-openjdk` pulls them in on either one.

# Kernel and Raspberry Pi firmware
linux-rpi
raspberrypi-bootloader
firmware-raspberrypi
# vcgencmd and friends; Arch Linux ARM renamed this from raspberrypi-firmware
raspberrypi-utils
linux-firmware-whence
mkinitcpio

# Base system
sudo
polkit
dbus
zram-generator
# checkupdates, for the Updater app: it lists pending updates without touching
# the real sync database.
pacman-contrib

# Networking
networkmanager
wpa_supplicant
wireless-regdb
openssh
wget
curl
ca-certificates
bluez
bluez-utils

# Web browser for the desktop shell's browser launcher and its music player.
# Microsoft publishes no ARM64 Linux build of Edge, so Chromium is the only
# option here - and shipping the same browser on both images keeps the shell's
# behaviour identical across them.
chromium

# Storage helpers
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
gvfs
gvfs-mtp
udisks2
parted
rsync

# Graphics stack (the Pi uses the vc4/v3d KMS driver via modesetting)
xorg-server
xorg-xinit
xorg-xauth
xorg-xrandr
xorg-xset
xorg-xhost
xorg-xprop
xorg-xkill
xorg-xsetroot
xterm
openbox
# mesa absorbed the VA-API drivers (it only 'provides' libva-mesa-driver now),
# so listing that name separately breaks the build - it is no longer a package.
mesa
xdg-utils
xdg-user-dirs
# Screen capture for the shell's screenshot tool.
scrot

# Fonts
ttf-dejavu
ttf-liberation
noto-fonts
noto-fonts-emoji
cantarell-fonts

# Audio
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
alsa-utils
# MPRIS transport control for the shell's music player.
playerctl

# Input
libinput
xf86-input-libinput

# Secrets (VS Code account sync / credential storage)
gnome-keyring
libsecret

# Runtime dependencies of the official Visual Studio Code arm64 build
gtk3
nss
nspr
alsa-lib
libxss
libxtst
libxkbcommon
libxkbcommon-x11
libdrm
libcups
at-spi2-core
libnotify
cairo
pango
libx11
libxcomposite
libxdamage
libxext
libxfixes
libxrandr
libxcb
expat
systemd-libs

# Developer tooling
git
base-devel
nodejs
npm
python
python-pip
man-db
less
nano
vim
zip
unzip
tree
htop
ripgrep
fd
bash-completion
openssl
gnupg
